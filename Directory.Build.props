<Project>
  <PropertyGroup>
    <DotNetComposeGenerateDiagnostics Condition="'$(DotNetComposeGenerateDiagnostics)' == ''">true</DotNetComposeGenerateDiagnostics>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="DotNetComposeGenerateDiagnostics" />
    <CompilerVisibleProperty Include="DotNetComposeUseStackAllocForArgumentStates" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
